# ==========================================
# Git Ignore Configuration
# Project: Interview Preparation Assistant
# ==========================================

# ── Environment & Secrets ─────────────────
.env
.env.local
.env.*.local
backend/.env
frontend/.env
*.env

# ── Python & Virtual Environment ──────────
venv/
.venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ── Byte-compiled / Optimized files ───────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# ── Node.js / Frontend ───────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Databases ─────────────────────────────
*.db
*.sqlite
*.sqlite3
interview_assistant.db

# ── Uploads & Generated Media ─────────────
uploads/resumes/*
uploads/reports/*
!uploads/resumes/.gitkeep
!uploads/reports/.gitkeep

# ── IDEs & Operating System ───────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── Agent & LangGraph Artifacts ──────────
.langgraph_api/
.gemini/
.antigravity/
