# Application Settings
PROJECT_NAME="Interview Preparation Assistant using Multi-Agent AI System"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000
FRONTEND_URL="http://localhost:5173"
CORS_ORIGINS="*"

# Database Connection (MySQL or SQLite fallback)
DATABASE_URL="mysql+pymysql://root:password@localhost:3306/interview_assistant_db"

# JWT Security
JWT_SECRET_KEY="your_secure_random_jwt_secret_key_here"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Groq LLM API Settings
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"

# LangSmith Observability & Tracing (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY="your_langsmith_api_key_here"
LANGCHAIN_PROJECT="interview-preparation-assistant"

# Storage Directories
UPLOAD_DIR="uploads"
RESUME_DIR="uploads/resumes"
REPORT_DIR="uploads/reports"
